[Unit]
Description=Servico WSGI Gunicorn - Baixas Kit Escolar FUNFARME
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/Baixas_Qrcode
Environment="PATH=/home/ubuntu/Baixas_Qrcode/.venv/bin"
ExecStart=/home/ubuntu/Baixas_Qrcode/.venv/bin/gunicorn -c gunicorn.conf.py "run:app"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target